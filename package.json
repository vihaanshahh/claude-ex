{
  "name": "claude-ex",
  "version": "1.5.1",
  "description": "Local code intelligence layer for Claude Code — indexes codebases into a SQLite graph database with symbols, dependency edges, and PageRank",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "claude-ex": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepush": "npm run build && npm run test",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vihaanshahh/claude-ex.git"
  },
  "keywords": [
    "claude",
    "code-intelligence",
    "mcp",
    "tree-sitter",
    "sqlite",
    "claude-code"
  ],
  "author": "vihaanshahh",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "tree-sitter": "^0.25.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.23.2",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "tree-sitter-typescript": {
      "tree-sitter": "$tree-sitter"
    },
    "tree-sitter-json": {
      "tree-sitter": "$tree-sitter"
    },
    "tree-sitter-css": {
      "tree-sitter": "$tree-sitter"
    },
    "tree-sitter-html": {
      "tree-sitter": "$tree-sitter"
    },
    "tree-sitter-rust": {
      "tree-sitter": "$tree-sitter"
    },
    "tree-sitter-c": {
      "tree-sitter": "$tree-sitter"
    },
    "tree-sitter-cpp": {
      "tree-sitter": "$tree-sitter"
    }
  }
}
